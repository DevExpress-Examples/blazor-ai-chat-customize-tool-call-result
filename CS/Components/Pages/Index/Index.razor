@page "/"

@using System.Text.Json
@using DevExpress.AIIntegration.Tools
@using DxAiChatCustomToolCallingChartReport.Services
@using DxAiChatCustomToolCallingChartReport.Models

@inject HelpDeskAITools helpDeskAITools
@inject AIToolsContextContainer AIToolsContainer
@implements IDisposable

<PageTitle>AI Chat</PageTitle>

<DxAIChat UseStreaming="true" ShowHeader="true">
    <MessageContentTemplate>
        @context.Content

        @if (TryGetChartData(context, out var chartData)) {
            <DxChart Data="@chartData" Width="100%" Height="300px"
                     CustomizeSeriesPoint="OnCustomizePoint">
                <DxChartBarSeries ArgumentField="@((ChartReportData d) => d.Label)"
                                  ValueField="@((ChartReportData d) => d.Value)"
                                  Name="Tickets" />
                <DxChartLegend Visible="false" />
            </DxChart>
        }
    </MessageContentTemplate>
    <PromptSuggestions>
        <DxAIChatPromptSuggestion Title="Feedback Chart"
                                  Text="Show Help Desk feedback chart"
                                  PromptMessage="What are our latest Help Desk ticket feedback ratings?"
                                  SendOnClick="true" />
        <DxAIChatPromptSuggestion Title="Positive vs. Negative Chart"
                                  Text="Show positive and negative feedback only"
                                  PromptMessage="Show Help Desk feedback chart with only Positive and Negative ratings."
                                  SendOnClick="true" />
    </PromptSuggestions>
</DxAIChat>

@code {
    private AIToolsContext? toolsContext;

    private static bool TryGetChartData(BlazorChatMessage message, out List<ChartReportData> chartData)
    {
        JsonElement? jsonRepresentation = message
            .FunctionCalls
            .FirstOrDefault(fc => fc.Request?.Name == HelpDeskAITools.GetFeedbackChartToolName)?
            .Result?
            .Result as System.Text.Json.JsonElement?;

        chartData = jsonRepresentation?.Deserialize<List<ChartReportData>>() ?? [];

        return chartData.Count > 0;
    }

    private void OnCustomizePoint(ChartSeriesPointCustomizationSettings settings) {
        var label = settings.Point.Argument?.ToString();

        switch (label)
        {
            case HelpDeskDataService.PositiveFeedbackLabel:
                settings.PointAppearance.Color = System.Drawing.Color.Green;
                break;
            case HelpDeskDataService.NegativeFeedbackLabel:
                settings.PointAppearance.Color = System.Drawing.Color.Red;
                break;
            case HelpDeskDataService.NeutralFeedbackLabel:
                settings.PointAppearance.Color = System.Drawing.Color.Orange;
                break;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            toolsContext = new AIToolsContextBuilder()
                .WithToolMethods(helpDeskAITools.GetFeedbackChart)
                .Build();

            AIToolsContainer.Add(toolsContext);
        }
    }

    public void Dispose()
    {
        AIToolsContainer.Remove(toolsContext);
        toolsContext?.Dispose();
    }
}